extends Node3D
## Builds the 3D dungeon from DungeonMap.MAP using placeholder meshes:
## a cube per wall cell, a floor + ceiling plane per floor cell, a sliding
## panel per door cell, and a sprite + light per wall torch.

const DungeonMap := preload("res://scripts/dungeon_map.gd")
const TorchLight := preload("res://scripts/torch.gd")
const MonsterScript := preload("res://scripts/monster.gd")
const ItemStack := preload("res://scripts/item_stack.gd")

# Art is generated by tools/art/build_all.py (or replace with your own).
# If a texture is missing, the flat colour is used instead.
const WALL_TEXTURE := "res://art/tiles/wall.png"
const FLOOR_TEXTURE := "res://art/tiles/floor.png"
const CEILING_TEXTURE := "res://art/tiles/ceiling.png"
const STAIRS_TEXTURE := "res://art/tiles/stairs.png"
const DOOR_TEXTURE := "res://art/tiles/door.png"
const DOOR_LOCKED_TEXTURE := "res://art/tiles/door_locked.png"
const ITEM_HEIGHT := 0.22  # Low, near the floor -- "at the feet" of the view, not hip-height.
const ITEM_BOB := 0.05
const THROW_HEIGHT := 0.6          # A thrown item flies at about hand height...
const THROW_TIME_PER_TILE := 0.08  # ...this fast.
const TORCH_SHEET := "res://art/sprites/torch.png"  # Frames of 16x32 side by side (any number, see _make_torch_frames).
const WALL_COLOR := Color(0.45, 0.40, 0.35)
const FLOOR_COLOR := Color(0.28, 0.25, 0.22)
const CEILING_COLOR := Color(0.20, 0.18, 0.17)
const DOOR_COLOR := Color(0.40, 0.26, 0.14)

const DOOR_THICKNESS := 0.2
const DOOR_OPEN_TIME := 0.6
const TORCH_PIXEL_SIZE := 0.03  # World units per sprite pixel.
const TORCH_HEIGHT := 1.3
const TORCH_ENERGY := 0.9

# Grid direction (x, z) per wall side; same order as DungeonMap.TORCHES / player.gd.
const SIDE_DIRS: Array[Vector2i] = [
	Vector2i(0, -1), Vector2i(-1, 0), Vector2i(0, 1), Vector2i(1, 0),
]

const PLATE_TEXTURE := "res://art/tiles/plate.png"
const LEVER_SHEET := "res://art/sprites/lever.png"  # 2 frames of 16x16: off, on.
const PLATE_SIZE := 1.1
const PLATE_UP_Y := 0.05     # Plate centre height when raised...
const PLATE_DOWN_Y := -0.03  # ...and when pressed (sunk below the floor line).
const LEVER_PIXEL_SIZE := 0.05
const LEVER_HEIGHT := 1.0

## False builds just the architecture, torches, plates and levers: no items, no monsters. The
## main menu uses this to show the level as a backdrop (see main_menu.gd).
@export var populate := true

var doors := {}       # Vector2i cell -> door MeshInstance3D
var door_want := {}   # Vector2i cell -> true if the door is currently told to be open
var plate_pressed := {}  # Vector2i cell -> true while the party stands on it (to sound the click once)
var door_tweens := {} # Vector2i cell -> the Tween moving it
var items := {}        # Vector2i cell -> {"sprite": Sprite3D, "pile": Array of ItemStack, top last} on the floor
var plates := {}      # Vector2i cell -> pressure plate MeshInstance3D
var levers := {}      # Vector3i (x, z, side) -> lever Sprite3D
var lever_on := {}    # Vector3i (x, z, side) -> true if switched on


func _ready() -> void:
	add_to_group("dungeon")  # Lets the player find us (see player.gd _interact).
	DungeonMap.reset_run()

	var s := DungeonMap.TILE_SIZE
	var h := DungeonMap.WALL_HEIGHT

	# Meshes and materials are shared by every tile.
	var wall_mesh := BoxMesh.new()
	wall_mesh.size = Vector3(s, h, s)
	wall_mesh.material = _make_material(WALL_COLOR, WALL_TEXTURE)

	var floor_mesh := PlaneMesh.new()
	floor_mesh.size = Vector2(s, s)
	floor_mesh.material = _make_material(FLOOR_COLOR, FLOOR_TEXTURE)

	# The stairs are just a floor tile with a "steps going down" picture on it.
	var stairs_mesh := PlaneMesh.new()
	stairs_mesh.size = Vector2(s, s)
	stairs_mesh.material = _make_material(Color(0.1, 0.1, 0.12), STAIRS_TEXTURE)

	var ceiling_mesh := PlaneMesh.new()
	ceiling_mesh.size = Vector2(s, s)
	ceiling_mesh.material = _make_material(CEILING_COLOR, CEILING_TEXTURE)

	var door_mesh := BoxMesh.new()
	door_mesh.size = Vector3(s, h, DOOR_THICKNESS)
	door_mesh.material = _make_material(DOOR_COLOR, DOOR_TEXTURE)

	var locked_mesh := BoxMesh.new()
	locked_mesh.size = door_mesh.size
	locked_mesh.material = _make_material(DOOR_COLOR, DOOR_LOCKED_TEXTURE)

	for z in DungeonMap.MAP.size():
		for x in DungeonMap.MAP[z].size():
			var cell := Vector2i(x, z)
			var pos := DungeonMap.cell_to_world(cell)
			if DungeonMap.is_wall(cell):
				_add_mesh(wall_mesh, pos + Vector3(0, h / 2.0, 0))
				continue
			# Everything that isn't a wall (floor and doors) gets a floor and ceiling.
			_add_mesh(stairs_mesh if DungeonMap.is_stairs(cell) else floor_mesh, pos)
			# Flip the plane upside down so its face points down at the player.
			_add_mesh(ceiling_mesh, pos + Vector3(0, h, 0), Vector3(PI, 0, 0))
			if DungeonMap.is_door(cell):
				var mesh := locked_mesh if DungeonMap.is_locked(cell) else door_mesh
				_add_door(mesh, cell, pos + Vector3(0, h / 2.0, 0))

	for torch in DungeonMap.TORCHES:
		_add_torch(Vector2i(torch.x, torch.y), torch.z)
	if populate:
		for entry in DungeonMap.ITEMS:
			place_item(entry.cell, ItemStack.of(load(entry.def), entry.get("count", 1)))
		for entry in DungeonMap.MONSTERS:
			spawn_monster(load(entry.def), entry.cell)
	for plate in DungeonMap.PLATES:
		_add_plate(plate.cell)
	for lever in DungeonMap.LEVERS:
		_add_lever(lever.cell, lever.side)
	refresh()


## Add a monster (a MonsterDef at a cell). hp and attack_cooldown override its starting
## values (used when loading a save).
func spawn_monster(def: Resource, cell: Vector2i, hp := -1, attack_cooldown := -1.0) -> Node:
	var monster := MonsterScript.new()
	monster.setup(def, cell)
	add_child(monster)
	if hp >= 0:
		monster.hp = hp
	if attack_cooldown >= 0.0:
		monster.attack_cooldown = attack_cooldown
	return monster


## Remove every monster at once (used when loading a save).
func clear_monsters() -> void:
	for n in get_children():
		if n.has_method("take_hit"):
			n.free()  # Immediately, so its tile is released before new monsters claim tiles.


## Put every door straight into the given open/closed state, with no animation (loading
## a save). `open` is a set of cells whose doors are open.
func restore_doors(open: Dictionary) -> void:
	DungeonMap.open_doors.clear()
	for cell in doors:
		if door_tweens.has(cell):
			door_tweens[cell].kill()
			door_tweens.erase(cell)
		var is_open := open.has(cell)
		door_want[cell] = is_open
		doors[cell].position.y = DungeonMap.WALL_HEIGHT / 2.0 + (DungeonMap.WALL_HEIGHT if is_open else 0.0)
		if is_open:
			DungeonMap.open_doors[cell] = true


## Set every lever on or off (loading a save). `on` is a set of Vector3i (x, z, side).
func restore_levers(on: Dictionary) -> void:
	lever_on.clear()
	for key in levers:
		lever_on[key] = on.has(key)
		levers[key].frame = 1 if on.has(key) else 0


## Replace the whole pile on a cell (bottom first); an empty list clears the cell.
func set_pile(cell: Vector2i, stacks: Array) -> void:
	if items.has(cell):
		items[cell].sprite.queue_free()
		items.erase(cell)
	if stacks.is_empty():
		return
	place_item(cell, stacks[0])
	for i in range(1, stacks.size()):
		items[cell].pile.append(stacks[i])  # Straight on: no merging, the pile is as it was saved.
	_show_top(items[cell])


## Re-evaluate every switch: sink/raise plates and open/close linked doors.
## The player calls this (via the "dungeon" group) whenever it changes tile.
func refresh() -> void:
	for cell in plates:
		var pressed: bool = DungeonMap.player_cell == cell
		plates[cell].position.y = PLATE_DOWN_Y if pressed else PLATE_UP_Y
		if plate_pressed.get(cell, false) != pressed:
			plate_pressed[cell] = pressed
			get_tree().call_group("audio", "play", "plate")
	for cell in doors:
		var id := DungeonMap.door_id(cell)
		if id != "":
			_drive_door(cell, _linked_open(id))


## Toggle a lever and its sprite, then update the doors. Called by the player.
func pull_lever(cell: Vector2i, side: int) -> void:
	var key := Vector3i(cell.x, cell.y, side)
	if not levers.has(key):
		return
	lever_on[key] = not lever_on.get(key, false)
	levers[key].frame = 1 if lever_on[key] else 0
	get_tree().call_group("audio", "play", "lever")
	refresh()


## Should the door with this ID be open? Yes if any of its levers is on or the
## player is standing on any of its plates.
func _linked_open(id: String) -> bool:
	for plate in DungeonMap.PLATES:
		if plate.target == id and DungeonMap.player_cell == plate.cell:
			return true
	for lever in DungeonMap.LEVERS:
		if lever.target == id and lever_on.get(Vector3i(lever.cell.x, lever.cell.y, lever.side), false):
			return true
	return false


func _add_plate(cell: Vector2i) -> void:
	var mesh := BoxMesh.new()
	mesh.size = Vector3(PLATE_SIZE, 0.1, PLATE_SIZE)
	mesh.material = _make_material(Color(0.5, 0.5, 0.55), PLATE_TEXTURE)
	var plate := _add_mesh(mesh, DungeonMap.cell_to_world(cell))
	plate.position.y = PLATE_UP_Y
	plates[cell] = plate


## A wall lever: a 2-frame sprite (off / on) hung on one wall of a cell.
func _add_lever(cell: Vector2i, side: int) -> void:
	var sprite := Sprite3D.new()
	if ResourceLoader.exists(LEVER_SHEET):
		sprite.texture = load(LEVER_SHEET)
	sprite.hframes = 2
	sprite.pixel_size = LEVER_PIXEL_SIZE
	sprite.texture_filter = BaseMaterial3D.TEXTURE_FILTER_NEAREST
	sprite.shaded = false
	sprite.alpha_cut = SpriteBase3D.ALPHA_CUT_DISCARD
	sprite.position = _wall_point(cell, side, LEVER_HEIGHT)
	sprite.rotation.y = _face_yaw(side)
	add_child(sprite)
	levers[Vector3i(cell.x, cell.y, side)] = sprite


## Point on the wall face at `side` of `cell`, at the given height (nudged off the wall).
func _wall_point(cell: Vector2i, side: int, height: float) -> Vector3:
	var d := SIDE_DIRS[side]
	var p := DungeonMap.cell_to_world(cell) + Vector3(d.x, 0, d.y) * (DungeonMap.TILE_SIZE / 2.0 - 0.02)
	p.y = height
	return p


## Yaw that turns a sprite (front = +Z) to face into the room, away from that wall.
func _face_yaw(side: int) -> float:
	return atan2(float(SIDE_DIRS[side].x) * -1.0, float(SIDE_DIRS[side].y) * -1.0)


## The top item stack lying on this floor cell, or null if there isn't one. A tile
## holds a pile (several stacks); only the top one can be picked up. Called directly
## by the player (get_tree().get_first_node_in_group("dungeon")), not via call_group,
## since it needs to return a value.
func item_at(cell: Vector2i) -> RefCounted:
	return items[cell].pile.back() if items.has(cell) else null


## Every stack in the pile on this cell, bottom first (empty if none).
func pile_at(cell: Vector2i) -> Array:
	return items[cell].pile.duplicate() if items.has(cell) else []


## Remove and return the top item stack on this cell (null if there wasn't one).
func take_item(cell: Vector2i) -> RefCounted:
	if not items.has(cell):
		return null
	var entry: Dictionary = items[cell]
	var stack: RefCounted = entry.pile.pop_back()
	if entry.pile.is_empty():
		entry.sprite.queue_free()
		items.erase(cell)
	else:
		_show_top(entry)
	return stack


## Put an item on a floor cell, on top of whatever is there (merging into the top
## stack if it's the same stackable item). The pile is one small sprite that bobs
## gently near the ground, showing the top item. Used for the level's starting items,
## items dropped from the cursor, and thrown weapons landing.
func place_item(cell: Vector2i, item) -> void:
	var stack: RefCounted = ItemStack.wrap(item)  # An ItemDef (one) or a whole stack.
	if items.has(cell):
		var entry: Dictionary = items[cell]
		entry.pile.back().merge_from(stack)
		if stack.count > 0:
			entry.pile.append(stack)
		_show_top(entry)
		return
	var sprite := Sprite3D.new()
	sprite.texture_filter = BaseMaterial3D.TEXTURE_FILTER_NEAREST
	sprite.billboard = BaseMaterial3D.BILLBOARD_ENABLED
	sprite.shaded = false
	sprite.alpha_cut = SpriteBase3D.ALPHA_CUT_DISCARD
	sprite.position = DungeonMap.cell_to_world(cell) + Vector3(0, ITEM_HEIGHT, 0)
	add_child(sprite)
	var new_entry := {"sprite": sprite, "pile": [stack]}
	items[cell] = new_entry
	_show_top(new_entry)
	# Bob up and down forever (the tween is owned by the sprite, so it dies with it).
	var bob := sprite.create_tween().set_loops()
	bob.tween_property(sprite, "position:y", ITEM_HEIGHT + ITEM_BOB, 0.9).set_trans(Tween.TRANS_SINE)
	bob.tween_property(sprite, "position:y", ITEM_HEIGHT - ITEM_BOB, 0.9).set_trans(Tween.TRANS_SINE)


func _show_top(entry: Dictionary) -> void:
	var def: Resource = entry.pile.back().def
	entry.sprite.texture = def.floor_icon if def.floor_icon else def.icon  # The small floor version.
	entry.sprite.pixel_size = def.icon_pixel_size


## Show a thrown item flying from the party's tile to where it lands (for show only:
## Party has already resolved the hit and placed the item). Also called via the group.
func show_throw(from_cell: Vector2i, to_cell: Vector2i, def: Resource) -> void:
	var sprite := Sprite3D.new()
	sprite.texture = def.floor_icon if def.floor_icon else def.icon
	sprite.pixel_size = def.icon_pixel_size
	sprite.texture_filter = BaseMaterial3D.TEXTURE_FILTER_NEAREST
	sprite.billboard = BaseMaterial3D.BILLBOARD_ENABLED
	sprite.shaded = false
	sprite.alpha_cut = SpriteBase3D.ALPHA_CUT_DISCARD
	sprite.position = DungeonMap.cell_to_world(from_cell) + Vector3(0, THROW_HEIGHT, 0)
	add_child(sprite)
	var tiles := maxf(1.0, (to_cell - from_cell).length())
	var t := sprite.create_tween()
	t.tween_property(sprite, "position", DungeonMap.cell_to_world(to_cell) + Vector3(0, ITEM_HEIGHT, 0), THROW_TIME_PER_TILE * tiles)
	t.tween_callback(sprite.queue_free)


## Open an ordinary door (F). Called by the player via the "dungeon" group.
func open_door(cell: Vector2i) -> void:
	if not DungeonMap.is_locked(cell):
		_drive_door(cell, true)


## Slide a door up into the ceiling (open) or back down (closed). Doors can be
## reversed mid-slide. Open doors are walkable only once fully open; closing makes
## them solid immediately. A door never closes on the player standing in it: it
## (or a monster) stays open until they leave and the next refresh() shuts it.
func _drive_door(cell: Vector2i, open: bool) -> void:
	if not doors.has(cell) or door_want.get(cell, false) == open:
		return
	if not open and (DungeonMap.player_cell == cell or DungeonMap.is_occupied(cell)):
		return
	door_want[cell] = open
	get_tree().call_group("audio", "play", "door_open" if open else "door_close")
	if door_tweens.has(cell):
		door_tweens[cell].kill()

	var h := DungeonMap.WALL_HEIGHT
	var door: MeshInstance3D = doors[cell]
	var target_y := h / 2.0 + (h if open else 0.0)
	var time := DOOR_OPEN_TIME * absf(target_y - door.position.y) / h
	var tween := create_tween()
	tween.tween_property(door, "position:y", target_y, time)
	if open:
		# Only become walkable once the panel is out of the way.
		tween.tween_callback(func(): DungeonMap.open_doors[cell] = true)
	else:
		DungeonMap.open_doors.erase(cell)
	door_tweens[cell] = tween


func _add_door(mesh: Mesh, cell: Vector2i, pos: Vector3) -> void:
	# The panel fills the gap between two side walls: if walls sit east and west of
	# the cell the corridor runs north-south and the panel spans X; otherwise turn it.
	var spans_x := DungeonMap.is_wall(cell + Vector2i(1, 0)) and DungeonMap.is_wall(cell + Vector2i(-1, 0))
	doors[cell] = _add_mesh(mesh, pos, Vector3(0, 0.0 if spans_x else PI / 2.0, 0))


## Hang an animated torch sprite (plus a flickering light) on one wall of a cell.
func _add_torch(cell: Vector2i, side: int) -> void:
	var dir := Vector3(SIDE_DIRS[side].x, 0, SIDE_DIRS[side].y)
	var wall_pos := _wall_point(cell, side, TORCH_HEIGHT)

	var sprite := AnimatedSprite3D.new()
	sprite.sprite_frames = _make_torch_frames()
	sprite.pixel_size = TORCH_PIXEL_SIZE
	sprite.texture_filter = BaseMaterial3D.TEXTURE_FILTER_NEAREST
	sprite.shaded = false                               # Glows regardless of lights.
	sprite.alpha_cut = SpriteBase3D.ALPHA_CUT_DISCARD   # Hard pixel edges, no sorting issues.
	sprite.position = wall_pos
	sprite.rotation.y = _face_yaw(side)                 # Face into the room.
	add_child(sprite)
	sprite.play("default")

	var light := OmniLight3D.new()
	light.set_script(TorchLight)
	light.base_energy = TORCH_ENERGY
	light.light_color = Color(1.0, 0.65, 0.35)
	light.omni_range = 5.0
	light.omni_attenuation = 1.5
	light.position = wall_pos - dir * 0.4 + Vector3(0, 0.3, 0)
	add_child(light)


## Cut the torch sprite sheet (one row of frames, each half as wide as it is tall) into an
## animation. The number of frames is read from the sheet itself, so art with more frames
## just works. Returns an empty set if the sheet is missing.
func _make_torch_frames() -> SpriteFrames:
	return torch_frames_from(load(TORCH_SHEET) if ResourceLoader.exists(TORCH_SHEET) else null)


## The torch animation from a sheet texture (null gives an empty one).
func torch_frames_from(sheet: Texture2D) -> SpriteFrames:
	var frames := SpriteFrames.new()  # Comes with an animation called "default".
	frames.set_animation_speed("default", 8.0)
	if sheet != null:
		var frame_h := sheet.get_height()
		var frame_w := maxi(1, int(frame_h * 0.5))  # Torch frames are 1:2 (16x32 as drawn).
		for i in maxi(1, int(sheet.get_width() / float(frame_w))):
			var frame := AtlasTexture.new()
			frame.atlas = sheet
			frame.region = Rect2(i * frame_w, 0, frame_w, frame_h)
			frames.add_frame("default", frame)
	return frames


func _add_mesh(mesh: Mesh, pos: Vector3, rot := Vector3.ZERO) -> MeshInstance3D:
	var instance := MeshInstance3D.new()
	instance.mesh = mesh
	instance.position = pos
	instance.rotation = rot
	add_child(instance)
	return instance


## Material with nearest filtering. Uses the texture if it exists, else a flat colour.
func _make_material(color: Color, texture_path: String) -> StandardMaterial3D:
	var mat := StandardMaterial3D.new()
	if ResourceLoader.exists(texture_path):
		mat.albedo_texture = load(texture_path)
	else:
		mat.albedo_color = color
	mat.texture_filter = BaseMaterial3D.TEXTURE_FILTER_NEAREST
	return mat
