extends Node3D
## Builds the 3D dungeon from DungeonMap.MAP using placeholder meshes:
## a cube per wall cell, a floor + ceiling plane per floor cell, a sliding
## panel per door cell, and a sprite + light per wall torch.

const Events := preload("res://scripts/game_events.gd")
const WallSigns := preload("res://scripts/wall_signs.gd")
const TrapField := preload("res://scripts/trap_field.gd")
const LightField := preload("res://scripts/light_field.gd")
const SpriteLighting := preload("res://scripts/sprite_lighting.gd")
const DungeonMap := preload("res://scripts/dungeon_map.gd")
const TorchLight := preload("res://scripts/torch.gd")
const NormalMaps := preload("res://scripts/normal_maps.gd")
const SpellEffectsConfigScript := preload("res://scripts/spell_effects_config.gd")
const MonsterScript := preload("res://scripts/monster.gd")
const WallDebris := preload("res://scripts/wall_debris.gd")
const ItemStack := preload("res://scripts/item_stack.gd")
const CorruptWall := preload("res://scripts/corrupt_wall.gd")
const Puzzles := preload("res://scripts/puzzles.gd")
const SealShow := preload("res://scripts/seal_show.gd")
const BrazierField := preload("res://scripts/brazier_field.gd")
const RuneField := preload("res://scripts/rune_field.gd")
const SaveData := preload("res://scripts/save_data.gd")
const LightConfig := preload("res://scripts/light_config.gd")
const CurseZones := preload("res://scripts/curse_zones.gd")
const OilField := preload("res://scripts/oil_field.gd")
const GasField := preload("res://scripts/gas_field.gd")

# Art is generated by tools/art/build_all.py (or replace with your own).
# If a texture is missing, the flat colour is used instead.
const CURSE_GLOW := 2.0  # Emission strength of the cracked wall's green crack.
const WALL_TEXTURE := "res://art/tiles/wall.png"
## Plain walls pick one of these by their cell, so a corridor is not one repeated pattern.
const WallDecor := preload("res://scripts/wall_decor.gd")  # The ancient stone look (data/wall_decor.tres).
const WALL_VARIANTS := ["res://art/tiles/wall.png", "res://art/tiles/wall_2.png", "res://art/tiles/wall_3.png"]
const WALL_CRACKED_TEXTURE := "res://art/tiles/wall_cracked.png"
const WALL_CORRUPTED_TEXTURE := "res://art/tiles/wall_corrupted.png"
const FLOOR_TEXTURE := "res://art/tiles/floor.png"
const CEILING_TEXTURE := "res://art/tiles/ceiling.png"
const STAIRS_TEXTURE := "res://art/tiles/stairs.png"
const DOOR_TEXTURE := "res://art/tiles/door.png"
const DOOR_LOCKED_TEXTURE := "res://art/tiles/door_locked.png"
const PORTCULLIS_TEXTURE := "res://art/tiles/portcullis.png"
const ITEM_HEIGHT := 0.22  # Low, near the floor -- "at the feet" of the view, not hip-height.
const ITEM_BOB := 0.05
const THROW_HEIGHT := 0.6          # A thrown item flies at about hand height...
const THROW_TIME_PER_TILE := 0.08  # ...this fast.
const TORCH_SHEET := "res://art/sprites/torch.png"  # Frames of 16x32 side by side (any number, see _make_torch_frames).
const WALL_COLOR := Color(0.45, 0.40, 0.35)
const FLOOR_COLOR := Color(0.28, 0.25, 0.22)
const CEILING_COLOR := Color(0.20, 0.18, 0.17)
const DOOR_COLOR := Color(0.40, 0.26, 0.14)

const DOOR_THICKNESS := 0.2
const DOOR_OPEN_TIME := 0.6
const PORTCULLIS_TIME := 1.5   # A heavy grate: it rises and drops more slowly than a door.
const TORCH_PIXEL_SIZE := 0.03  # World units per sprite pixel.
const TORCH_HEIGHT := 1.3
const TORCH_ENERGY := 0.9
const SCONCE_SHEETS := {DungeonMap.SCONCE_UNLIT: "res://art/sprites/sconce_unlit.png", DungeonMap.SCONCE_EMPTY: "res://art/sprites/sconce_empty.png"}  # PixelLab (gen_sconce.py): 32x64; a lit one is the animated torch.
const SCONCE_PIXEL_SIZE := 0.015  # World units per art pixel of those two: the same size on the wall as the 16x32 lit torch at 0.03.

# Grid direction (x, z) per wall side; same order as DungeonMap.TORCHES / player.gd.
const SIDE_DIRS: Array[Vector2i] = [
	Vector2i(0, -1), Vector2i(-1, 0), Vector2i(0, 1), Vector2i(1, 0),
]

const PLATE_TEXTURE := "res://art/tiles/plate.png"
const LEVER_SHEET := "res://art/sprites/lever.png"  # 2 frames of 16x16: off, on.
const PLATE_SIZE := 1.1
const PLATE_UP_Y := 0.05     # Plate centre height when raised...
const PLATE_DOWN_Y := -0.03  # ...and when pressed (sunk below the floor line).
const LEVER_PIXEL_SIZE := 0.0125   # 64 px frames (gen_lever.py): 0.8 world units wide, the size of the original 16 px lever.
const LEVER_CALL := Color(1.0, 0.8, 0.5)   # The lever's soft warm light.
const LEVER_HEIGHT := 1.0

## False builds just the architecture, torches, plates and levers: no items, no monsters. The
## main menu uses this to show the level as a backdrop (see main_menu.gd).
@export var populate := true

var doors := {}       # Vector2i cell -> door MeshInstance3D
var walls := {}       # Vector2i cell -> the cracked wall block there (only cracked walls are kept: they can break)
var rubble := {}      # Vector2i cell -> the static rubble decoration left where a wall broke
var corrupt := {}     # Vector2i cell -> the CorruptWall node (the show) of every corrupted wall still standing
var _decor: RefCounted  # The ancient wall look (wall_decor.gd): kept so a cell that opens can get the faces beside it
var _floor_mesh: Mesh
var _ceiling_mesh: Mesh
var _wall_material: Material
var _curse_material: StandardMaterial3D  # The cracked wall's: its green crack glows (emission), and dims in holy light.
var _curse_tween: Tween
var door_want := {}   # Vector2i cell -> true if the door is currently told to be open
var plate_pressed := {}  # Vector2i cell -> true while the party stands on it (to sound the click once)
var door_tweens := {} # Vector2i cell -> the Tween moving it
var alcoves := []         # The wall niches with a candle ({cell, node, lit_mesh, out_mesh, light, lit}): wall_decor.add_alcove fills it; a curse zone can put them out.
var sconces := {}       # Vector3i(x, z, side) -> {"sprite": Node3D, "light": OmniLight3D or null}: what hangs in each wall sconce now.
var gas: Node3D        # Toxic gas clouds (gas_field.gd, group "gas").
var oil: Node3D        # Oil slicks and burning tiles (oil_field.gd, group "oil").
var curse: Node3D      # The curse zones: haze, Bless pockets, flames that die (curse_zones.gd, group "curse_zones").
var traps: Node3D      # The armed traps (trap_field.gd, group "traps").
var lights: Node3D     # Lights burning on the floor (light_field.gd, group "lights").
var items := {}        # Vector2i cell -> {"sprite": Sprite3D, "pile": Array of ItemStack, top last} on the floor
var plates := {}      # Vector2i cell -> pressure plate MeshInstance3D
var levers := {}      # Vector3i (x, z, side) -> lever Sprite3D
var lever_on := {}    # Vector3i (x, z, side) -> true if switched on


## False while the level is being built or a save is being put on it: no puzzle is checked and no puzzle news is sent.
var settled := false
var rune_field: Node3D  # The darkness runes (rune_field.gd, "Runes").
var _rune_faces := {}   # Rune wall cell -> the nodes that draw it: they go when it opens.
var braziers: Node3D   # The braziers' bowls, flames and lights (brazier_field.gd, "Braziers").
var seal_show: Node3D  # What seals and reliquaries look like (seal_show.gd, "SealShow").
const RELIQUARY_ITEM_HEIGHT := 0.55  # Items on a reliquary's tile rest at its open mouth.
## DungeonMap.level_serial when this dungeon was built: a dungeon left behind by a change of level checks no puzzles.
var level_serial := 0
var _plate_was_held := {}  # Plate cell -> was somebody on it at the last refresh.


func _ready() -> void:
	add_to_group("dungeon")  # Lets the player find us (see player.gd _interact).
	if not populate and DungeonMap.level_path != "":
		DungeonMap.use_level("")  # The main menu's backdrop is floor 1's corridor, whatever level was played last.
	DungeonMap.reset_run()
	level_serial = DungeonMap.level_serial
	DungeonMap.init_sconces(LightConfig.get_config().sconce_torch_seconds)

	var s := DungeonMap.TILE_SIZE
	var h := DungeonMap.WALL_HEIGHT
	var decor := WallDecor.new()
	_decor = decor

	# Meshes and materials are shared by every tile.
	var wall_meshes: Array[Mesh] = []
	for path in WALL_VARIANTS:
		wall_meshes.append(_wall_box(Vector3(s, h, s), _make_material(WALL_COLOR, path)))
	var wall_mesh: Mesh = wall_meshes[0]
	_wall_material = wall_mesh.surface_get_material(0)
	var cracked_mesh := BoxMesh.new()
	cracked_mesh.size = Vector3(s, h, s)
	cracked_mesh.material = _make_cracked_material()
	_curse_material = cracked_mesh.material

	var floor_mesh := PlaneMesh.new()
	floor_mesh.size = Vector2(s, s)
	floor_mesh.material = _make_material(FLOOR_COLOR, FLOOR_TEXTURE)

	# The stairs are just a floor tile with a "steps going down" picture on it.
	var stairs_mesh := PlaneMesh.new()
	stairs_mesh.size = Vector2(s, s)
	stairs_mesh.material = _make_material(Color(0.1, 0.1, 0.12), STAIRS_TEXTURE)

	var ceiling_mesh := PlaneMesh.new()
	ceiling_mesh.size = Vector2(s, s)
	ceiling_mesh.material = _make_material(CEILING_COLOR, CEILING_TEXTURE)

	# Doors show the whole picture on each face (a BoxMesh would show one cell of a 3x2 grid).
	var door_mesh := _wall_box(Vector3(s, h, DOOR_THICKNESS), _make_material(DOOR_COLOR, DOOR_TEXTURE))
	var locked_mesh := _wall_box(Vector3(s, h, DOOR_THICKNESS), _make_material(DOOR_COLOR, DOOR_LOCKED_TEXTURE))

	# The portcullis: a single double-sided quad of transparent iron bars (alpha cut-out), so the
	# gaps are really open and you can see through.
	var portcullis_mesh := QuadMesh.new()
	portcullis_mesh.size = Vector2(s, h)
	portcullis_mesh.material = _make_grate_material(PORTCULLIS_TEXTURE)

	_floor_mesh = floor_mesh
	_ceiling_mesh = ceiling_mesh

	for z in DungeonMap.MAP.size():
		for x in DungeonMap.MAP[z].size():
			var cell := Vector2i(x, z)
			var pos := DungeonMap.cell_to_world(cell)
			if DungeonMap.is_wall(cell):
				var before := get_child_count()
				if DungeonMap.is_corrupted(cell):  # Overgrown with the curse: its own block, veins and glow.
					corrupt[cell] = _add_corrupt_wall(cell)
				elif DungeonMap.is_destructible(cell):  # The crack is the tell.
					walls[cell] = _add_mesh(cracked_mesh, pos + Vector3(0, h / 2.0, 0))
				elif decor.active():
					decor.add_faces(self, cell)  # Stone, grime and decals on every face that can be seen.
				else:
					_add_mesh(wall_meshes[_wall_variant(cell)], pos + Vector3(0, h / 2.0, 0))
				if DungeonMap.is_rune_wall(cell):
					_rune_faces[cell] = get_children().slice(before)
				continue
			# Everything that isn't a wall (floor and doors) gets a floor and ceiling.
			_add_mesh(stairs_mesh if DungeonMap.is_stairs(cell) else floor_mesh, pos)
			# Flip the plane upside down so its face points down at the player.
			_add_mesh(ceiling_mesh, pos + Vector3(0, h, 0), Vector3(PI, 0, 0))
			if DungeonMap.is_door(cell):
				var mesh: Mesh = portcullis_mesh if DungeonMap.is_portcullis(cell) else (locked_mesh if DungeonMap.is_locked(cell) else door_mesh)
				_add_door(mesh, cell, pos + Vector3(0, h / 2.0, 0))

	if decor.active():
		decor.add_structures(self)
		decor.start_pulse(self)
	for torch in DungeonMap.TORCHES:
		_build_sconce(DungeonMap.sconce_key(torch))
	WallSigns.build(self)
	traps = TrapField.new()
	traps.name = "Traps"
	add_child(traps)
	lights = LightField.new()
	lights.name = "Lights"
	add_child(lights)
	oil = OilField.new()
	oil.name = "Oil"
	add_child(oil)
	gas = GasField.new()
	gas.name = "Gas"
	add_child(gas)
	curse = CurseZones.new()
	curse.name = "CurseZones"
	add_child(curse)
	rune_field = RuneField.new()
	rune_field.name = "Runes"
	add_child(rune_field)
	braziers = BrazierField.new()
	braziers.name = "Braziers"
	add_child(braziers)
	seal_show = SealShow.new()
	seal_show.name = "SealShow"
	add_child(seal_show)
	var puzzles := Puzzles.new()  # Listens to the event bus and re-checks every puzzle on any news (S7).
	puzzles.name = "Puzzles"
	add_child(puzzles)
	var sprite_lighting := SpriteLighting.new()
	sprite_lighting.name = "SpriteLighting"
	add_child(sprite_lighting)
	if populate:
		traps.place_level_traps()
		for entry in DungeonMap.ITEMS:
			place_item(entry.cell, ItemStack.of(load(entry.def), entry.get("count", 1)))
		for entry in DungeonMap.MONSTERS:
			var placed := spawn_monster(load(entry.def), entry.cell)
			placed.holds_ground = bool(entry.get("holds", false))  # Optional: it stays put until it sees the party (no random wandering).
		for bad in DungeonMap.zone_tier_violations():
			push_warning("curse zone '%s': a tier %d monster (%s) is placed at %s; nothing above tier 1 may stand in a zone" % [bad.zone, bad.tier, bad.def, bad.cell])
	for plate in DungeonMap.PLATES:
		_add_plate(plate.cell)
	for lever in DungeonMap.LEVERS:
		_add_lever(lever.cell, lever.side)
	refresh()
	_warn_unsealable()
	settled = true


## A puzzle that seals an area with a way out that has no door cannot keep anyone in: say so when the level loads.
func _warn_unsealable() -> void:
	for puzzle in DungeonMap.PUZZLES:
		for effect in puzzle.then:
			if effect.kind == "seal_area" and (DungeonMap.area_exits(effect.area).is_empty() or not DungeonMap.area_openings(effect.area).is_empty()):
				push_warning("area '%s': a seal cannot close it (open ways out: %s)" % [effect.area, str(DungeonMap.area_openings(effect.area))])


# --------------------------------------------------------------------------
# Seals, braziers, reliquaries, plates (puzzles use them; 7d's lock-in will use the seals)
# --------------------------------------------------------------------------

## Seal every way out of an area (DungeonMap.AREAS): its doors shut and cannot be opened by hand, key, lever, plate or puzzle until
## unsealed. A door never closes on the party or a monster standing in it: it shuts when they leave, and nobody new may step in.
## `owner` says who sealed it, so one sealer's unseal never undoes another's. A `saved` seal goes into the save file; one that is
## not is for a lock-in that works itself out again after a load (7d.4). Returns how many doors the area's seals hold.
func seal_area(id: String, owner := "puzzle", saved := true) -> int:
	if not DungeonMap.seals.has(id):
		DungeonMap.seals[id] = {}
	DungeonMap.seals[id][owner] = saved
	_sync_seals()
	return DungeonMap.area_exits(id).size()


## Take this owner's seal off the area. Switch doors then follow their switches; plain doors stay shut but open by hand.
func unseal_area(id: String, owner := "puzzle") -> void:
	if not DungeonMap.seals.has(id):
		return
	DungeonMap.seals[id].erase(owner)
	if DungeonMap.seals[id].is_empty():
		DungeonMap.seals.erase(id)
	_sync_seals()


## Work out which doors the seals hold and move the ones that changed.
func _sync_seals() -> void:
	var held := {}
	for id in DungeonMap.seals:
		for cell in DungeonMap.area_exits(id):
			held[cell] = true
	var released := DungeonMap.sealed_doors.keys().filter(func(c): return not held.has(c))
	DungeonMap.sealed_doors.clear()
	DungeonMap.sealed_doors.merge(held)
	for cell in held:
		_drive_door(cell, false)
	for cell in released:
		if DungeonMap.door_id(cell) != "":
			_drive_door(cell, _linked_open(DungeonMap.door_id(cell)))
	seal_show.sync(settled)


## The id of the runes fully showing on this wall of this tile, "" if none.
func runes_shown(cell: Vector2i, side: int) -> String:
	return rune_field.shown(cell, side)


## The party touches the runes showing on this wall: they are read, and the wall opens as a purified wall does (black rot, ash, a
## rumble), staying solid until the show is over. Returns whether there were runes to read.
func read_runes(cell: Vector2i, side: int) -> bool:
	var id := runes_shown(cell, side)
	if id == "":
		return false
	_open_runes(id, true)
	return true


func _open_runes(id: String, show: bool) -> void:
	for entry in DungeonMap.RUNES:
		if entry.id != id:
			continue
		var wall := DungeonMap.rune_wall(entry)
		DungeonMap.runes_read[id] = true
		if DungeonMap.runes_open.has(wall):
			return
		var clear := func():
			for node in _rune_faces.get(wall, []):
				if is_instance_valid(node):
					node.queue_free()
			_rune_faces.erase(wall)
			_open_cell(wall)
		var finish := func():
			DungeonMap.runes_open[wall] = true
			refresh()
		if show:
			var rot: Node3D = CorruptWall.new()
			rot.plain = true  # No veins and no holy light: only the rot, the ash and the rumble.
			add_child(rot)
			rot.setup(wall, null, 1)
			rot.purify(clear, finish)
			if settled:
				Events.send(get_tree(), "runes_read", [id])
		else:  # A loaded save: it is simply open.
			clear.call()
			finish.call()


## Fire that a brazier will take touches the one on this tile: a Fireball, or a torch from a wall sconce held to it (nothing else:
## not the party's own torches or candles, not a thrown torch, not burning oil). It catches unless there is none, it burns already,
## or a curse zone's air will not have it. Returns whether it caught.
func ignite_brazier(cell: Vector2i) -> bool:
	if not DungeonMap.brazier_lit.has(cell) or DungeonMap.brazier_lit[cell] or flame_blocked(cell):
		return false
	set_brazier(cell, true)
	get_tree().call_group("audio", "play", "fireball", -14.0, 1.5)  # (A placeholder whoosh: no lighting sound exists yet.)
	return true


## A Fireball flew from one tile to another and burst there: every brazier within a tile of its path (not counting the caster's own
## tile) or of the blast catches. Returns how many did.
func ignite_braziers_along(from_cell: Vector2i, to_cell: Vector2i) -> int:
	var step := (to_cell - from_cell).sign()
	var path: Array[Vector2i] = [to_cell]
	var c := from_cell + step
	while c != to_cell and step != Vector2i.ZERO and path.size() <= 16:
		path.append(c)
		c += step
	var count := 0
	for brazier in DungeonMap.brazier_lit.keys():
		for at in path:
			var d: Vector2i = (brazier - at).abs()
			if maxi(d.x, d.y) <= 1:
				count += 1 if ignite_brazier(brazier) else 0
				break
	return count


## Light or snuff a brazier (DungeonMap.BRAZIERS). Returns whether anything changed.
func set_brazier(cell: Vector2i, lit: bool) -> bool:
	if not DungeonMap.brazier_lit.has(cell) or DungeonMap.brazier_lit[cell] == lit:
		return false
	DungeonMap.brazier_lit[cell] = lit
	if settled:
		Events.send(get_tree(), "brazier_changed", [cell, lit])
	return true


## A reliquary rises on this tile with these items ([{"def": path, "count": n}]). Once per tile. The items are in the pile (and so in
## a save) at once; seal_show.gd hides them until the chest has come up and opened.
func raise_reliquary(cell: Vector2i, contents: Array) -> void:
	if DungeonMap.reliquaries.has(cell):
		return
	var lying := pile_at(cell)  # What was there already comes up with the chest.
	DungeonMap.reliquaries[cell] = true
	if not lying.is_empty():
		set_pile(cell, lying)
	for entry in contents:
		place_item(cell, ItemStack.of(load(entry.def), int(entry.get("count", 1))))
	seal_show.sync(settled)


## Is a reliquary still rising here? Its items cannot be touched until it has opened.
func reliquary_rising(cell: Vector2i) -> bool:
	return seal_show.rising(cell)


## Is somebody holding down the plate on this tile: the party or a monster? (7e.6 adds the weight of items here.)
func plate_held(cell: Vector2i) -> bool:
	return DungeonMap.player_cell == cell or DungeonMap.is_occupied(cell)


## Add a monster (a MonsterDef at a cell). hp and attack_cooldown override its starting
## values (used when loading a save).
func spawn_monster(def: Resource, cell: Vector2i, hp := -1, attack_cooldown := -1.0) -> Node:
	var monster := MonsterScript.new()
	monster.setup(def, cell)
	add_child(monster)
	if hp >= 0:
		monster.hp = hp
	if attack_cooldown >= 0.0:
		monster.attack_cooldown = attack_cooldown
	return monster


## Remove every monster at once (used when loading a save).
func clear_monsters() -> void:
	for n in get_children():
		if n.has_method("take_hit"):
			n.free()  # Immediately, so its tile is released before new monsters claim tiles.


# --------------------------------------------------------------------------
# Sconces (docs/design/expansion_design.md 7l.2)
# --------------------------------------------------------------------------
# A sconce holds one real torch or nothing: lighting it creates no torch, taking the torch empties the bracket, and hanging one back
# keeps the time it had (a torch burns down only in a hand), so torches are never made and never lost. The clicks are in player.gd.

## What the sconce holds (DungeonMap.SCONCE_*), or -1 if there is none at this key.
func sconce_at(key: Vector3i) -> int:
	return DungeonMap.sconce_state.get(key, -1)


## Seconds a torch in this sconce has left (0 for an empty bracket).
func sconce_time(key: Vector3i) -> float:
	return DungeonMap.sconce_seconds.get(key, 0.0)


func _set_sconce(key: Vector3i, state: int, seconds: float) -> void:
	DungeonMap.sconce_state[key] = state
	DungeonMap.sconce_seconds[key] = seconds if state != DungeonMap.SCONCE_EMPTY else 0.0
	_build_sconce(key)


## Is a flame refused on this tile: a curse zone is in force and no Bless pocket covers it? (A sconce, a brazier, oil, a torch lying here.)
func flame_blocked(cell: Vector2i) -> bool:
	return curse != null and curse.blocks_flame(cell)


## Is a wall sconce on this tile refused a flame: within 2 tiles of a curse zone's tiles (the haze's reach) and no Bless pocket over it?
func sconce_blocked(cell: Vector2i) -> bool:
	return curse != null and curse.blocks_sconce(cell)


## Is there fire on this tile: burning oil, or a burning torch lying there? Monsters that fear fire will not step onto it.
func fire_at(cell: Vector2i) -> bool:
	if oil != null and oil.is_burning(cell):
		return true
	if lights != null:
		for e in lights.burning:
			if e.cell == cell:
				return true
	return false


## Is a fixed light on this tile refused a flame: within 2 tiles of a curse zone's tiles (the haze's reach), no Bless pocket over it? A
## burning torch lying there, a niche's candle and a brazier (not built) ask this; a sconce too (sconce_blocked, the same rule).
func light_blocked(cell: Vector2i) -> bool:
	return sconce_blocked(cell)


## Light or put out the candle in a wall niche (its picture swaps to the one without a flame, its light is hidden).
func set_alcove_lit(alcove: Dictionary, lit: bool) -> void:
	alcove.lit = lit
	if alcove.out_mesh != null:
		alcove.node.mesh = alcove.lit_mesh if lit else alcove.out_mesh
	alcove.light.visible = lit


## Light an unlit sconce (a flame touched it): it burns for good and loses nothing. Returns whether it caught (not near a curse zone).
func light_sconce(key: Vector3i) -> bool:
	if sconce_at(key) != DungeonMap.SCONCE_UNLIT or sconce_blocked(Vector2i(key.x, key.y)):
		return false
	_set_sconce(key, DungeonMap.SCONCE_LIT, sconce_time(key))
	get_tree().call_group("audio", "play", "fireball", -14.0, 1.7)  # (A placeholder whoosh: no lighting sound exists yet.)
	return true


## Light every unlit sconce on a wall of a tile within `radius` of `cell` (a Fireball's blast, a lit torch thrown there). Returns how many.
func ignite_near(cell: Vector2i, radius := 1) -> int:
	var count := 0
	for key in sconces.keys():
		if maxi(absi(key.x - cell.x), absi(key.y - cell.y)) <= radius and light_sconce(key):
			count += 1
	return count


## Take the torch out of a lit or unlit sconce: a torch with the time it has left (120 s for one the level started with), or null
## if the bracket is empty. The bracket is empty after, and its stretch is dark if it was lit.
func take_sconce_torch(key: Vector3i, torch_def: Resource) -> RefCounted:
	if sconce_at(key) == DungeonMap.SCONCE_EMPTY or sconce_at(key) == -1:
		return null
	var stack: RefCounted = ItemStack.of(torch_def, 1)
	stack.burn_left = sconce_time(key)
	stack.from_wall = true
	_set_sconce(key, DungeonMap.SCONCE_EMPTY, 0.0)
	return stack


## Hang a torch (an item with `fits_sconce`) in an empty bracket: it burns there for good, keeping the time it had. One torch comes
## off the stack. Returns whether it went in.
func hang_sconce_torch(key: Vector3i, stack: RefCounted) -> bool:
	if sconce_at(key) != DungeonMap.SCONCE_EMPTY or stack == null or not stack.def.fits_sconce or stack.count < 1:
		return false
	var seconds: float = stack.seconds_left()
	stack.count -= 1
	# Hung in or beside a curse zone it does not catch: the torch hangs there unlit until the zone is lifted and a flame touches it.
	_set_sconce(key, DungeonMap.SCONCE_UNLIT if sconce_blocked(Vector2i(key.x, key.y)) else DungeonMap.SCONCE_LIT, seconds)
	return true


## A lit sconce in a curse zone goes out (curse_zones.gd, when a zone is back after a Bless's pocket, or at the start): it keeps its torch.
func snuff_sconce(key: Vector3i) -> void:
	if sconce_at(key) == DungeonMap.SCONCE_LIT:
		_set_sconce(key, DungeonMap.SCONCE_UNLIT, sconce_time(key))


## Note every sconce the party can see from where it stands (a clear line within sconce_see_range, or on its own tile): the map
## shows those, lit or dark. Called whenever the party moves (refresh).
func _mark_sconces_seen() -> void:
	var range_: int = LightConfig.get_config().sconce_see_range
	var from: Vector2i = DungeonMap.player_cell
	for key in sconces:
		if DungeonMap.sconce_seen.has(key):
			continue
		var at := Vector2i(key.x, key.y)
		var d: Vector2i = (at - from).abs()
		if maxi(d.x, d.y) <= range_ and (at == from or DungeonMap.has_line_of_sight(from, at)):
			DungeonMap.sconce_seen[key] = true


# --------------------------------------------------------------------------
# Saving (docs/code_review.md S1; save_game.gd gathers this with the other systems' states)
# --------------------------------------------------------------------------

## Everything about the level that changes during a run, as plain data: floor piles (with where thrown items came from, a
## light's burn time and whether it lies lit), open and unlocked doors, levers, live monsters (each one's save_state: hp,
## held and other statuses, boss greeting), broken, purified and corrupted walls, puzzles solved, armed bear traps.
## Level layout, art and item and monster definitions are data and come back from the game files.
func save_state() -> Dictionary:
	var piles := []
	for cell in items:
		piles.append({"cell": SaveData.cell_to_data(cell), "pile": items[cell].pile.map(SaveData.stack_to_data)})
	var broken := []
	for cell in DungeonMap.broken_walls:
		broken.append(SaveData.cell_to_data(cell))
	var purified := []  # (A wall whose purifying show is still running counts as burned away.)
	for cell in DungeonMap.purified:
		purified.append(SaveData.cell_to_data(cell))
	for cell in DungeonMap.purify_pending:
		if not DungeonMap.purified.has(cell):
			purified.append(SaveData.cell_to_data(cell))
	var corruption := []  # The corrupted walls still standing and the Blesses each still needs.
	for cell in DungeonMap.corrupted_left:
		if int(DungeonMap.corrupted_left[cell]) > 0 and not DungeonMap.purify_pending.has(cell):
			corruption.append({"cell": SaveData.cell_to_data(cell), "left": int(DungeonMap.corrupted_left[cell])})
	var open_doors := []
	for cell in DungeonMap.open_doors:
		open_doors.append(SaveData.cell_to_data(cell))
	var unlocked := []
	for cell in DungeonMap.unlocked_doors:
		unlocked.append(SaveData.cell_to_data(cell))
	var lever_list := []
	for key in lever_on:
		if lever_on[key]:
			lever_list.append([key.x, key.y, key.z])
	var monsters := []
	for n in get_children():
		if n.has_method("take_hit") and not n.dying:
			monsters.append(n.save_state())
	var sconce_list := []  # What hangs in each wall sconce, the burn time of the torch in it, and whether the party has seen it.
	for key in sconces:
		sconce_list.append({"cell": [key.x, key.y], "side": key.z, "state": sconce_at(key), "seconds": sconce_time(key),
				"seen": DungeonMap.sconce_seen.has(key)})
	return {"items": piles, "sconces": sconce_list, "open_doors": open_doors, "unlocked_doors": unlocked,
			"levers": lever_list, "monsters": monsters, "broken_walls": broken,
			"purified_walls": purified, "corruption": corruption,
			"puzzles_done": DungeonMap.puzzles_done.keys(), "puzzle_doors": DungeonMap.puzzle_doors.keys(),
			"armed_traps": traps.serialize() if traps != null else [],
			"seals": _saved_seals(),
			"reliquaries": DungeonMap.reliquaries.keys().map(SaveData.cell_to_data),
			"runes_read": DungeonMap.runes_read.keys(),
			"braziers": DungeonMap.brazier_lit.keys().map(func(c): return {"cell": SaveData.cell_to_data(c), "lit": DungeonMap.brazier_lit[c]}),
			"oil": oil.save_state() if oil != null else {"slicks": [], "burning": []}}


func _saved_seals() -> Array:
	var out := []
	for id in DungeonMap.seals:
		for owner in DungeonMap.seals[id]:
			if DungeonMap.seals[id][owner]:
				out.append({"area": id, "owner": owner})
	return out


## Is this saved level state usable? "" if so, else why not. Static and node-free (see Party.validate_state). Lists an older
## save did not have (broken and purified walls, corruption, puzzles, traps, statuses) may be missing, but not wrong.
static func validate_state(d) -> String:
	if not d is Dictionary:
		return "The save has no dungeon."
	for key in ["items", "open_doors", "unlocked_doors", "levers", "monsters"]:
		var problem: String = SaveData.need(d, key, "array", "saved dungeon")
		if problem != "":
			return problem
	if d.has("oil"):
		var oil_problem: String = OilField.validate_state(d.oil)
		if oil_problem != "":
			return oil_problem
	for key in ["broken_walls", "purified_walls", "corruption", "puzzles_done", "puzzle_doors", "armed_traps", "sconces", "seals", "reliquaries", "braziers", "runes_read"]:
		var problem: String = SaveData.maybe(d, key, "array", "saved dungeon")
		if problem != "":
			return problem
	var bad_cell := func(c): return "" if SaveData.is_cell(c) else "The saved doors or walls are damaged."
	for key in ["open_doors", "unlocked_doors", "broken_walls", "purified_walls"]:
		var problem: String = SaveData.each(d.get(key, []), bad_cell)
		if problem != "":
			return problem
	var problem: String = SaveData.each(d.levers, func(l): return "" if l is Array and l.size() == 3 and l.all(SaveData.is_number) else "The saved levers are damaged.")
	if problem == "":
		problem = SaveData.each(d.items, func(e): return "" if e is Dictionary and SaveData.is_cell(e.get("cell")) and e.get("pile") is Array and e.pile.all(SaveData.is_stack) else "The saved floor items are damaged.")
	if problem == "":
		problem = SaveData.each(d.get("corruption", []), func(e): return "" if e is Dictionary and SaveData.is_cell(e.get("cell")) and SaveData.is_number(e.get("left")) else "The saved corruption is damaged.")
	if problem == "":
		problem = SaveData.each(d.get("sconces", []), func(e): return "" if e is Dictionary and SaveData.is_cell(e.get("cell")) and SaveData.is_number(e.get("side")) and SaveData.is_number(e.get("state")) and int(e.state) >= 0 and int(e.state) <= 2 and SaveData.is_number(e.get("seconds")) else "The saved sconces are damaged.")
	if problem == "":
		problem = SaveData.each(d.get("armed_traps", []), func(t): return "" if t is Dictionary and SaveData.is_cell(t.get("cell")) and t.get("def") is String else "The saved traps are damaged.")
	if problem == "":
		problem = SaveData.each(d.get("seals", []), func(e): return "" if e is Dictionary and e.get("area") is String and e.get("owner") is String else "The saved seals are damaged.")
	if problem == "":
		problem = SaveData.each(d.get("runes_read", []), func(id): return "" if id is String else "The saved runes are damaged.")
	if problem == "":
		problem = SaveData.each(d.get("reliquaries", []), func(c): return "" if SaveData.is_cell(c) else "The saved reliquaries are damaged.")
	if problem == "":
		problem = SaveData.each(d.get("braziers", []), func(e): return "" if e is Dictionary and SaveData.is_cell(e.get("cell")) and e.get("lit") is bool else "The saved braziers are damaged.")
	if problem == "":
		problem = SaveData.each(d.monsters, func(m):
			if not (m is Dictionary and m.get("def") is String and SaveData.is_cell(m.get("cell")) and SaveData.is_number(m.get("hp")) and SaveData.is_number(m.get("attack_cooldown"))):
				return "The saved monsters are damaged."
			var statuses = m.get("statuses", [])
			if not statuses is Array or not statuses.all(func(st): return st is Dictionary and st.get("def") is String and SaveData.is_number(st.get("left")) and SaveData.is_number(st.get("source", -1))):
				return "The saved monsters are damaged."
			return "")
	return problem


## Put a saved level state (already checked with validate_state) onto this freshly built level.
func load_state(d: Dictionary) -> void:
	DungeonMap.unlocked_doors.clear()
	for c in d.unlocked_doors:
		DungeonMap.unlocked_doors[SaveData.data_to_cell(c)] = true
	var open := {}
	for c in d.open_doors:
		open[SaveData.data_to_cell(c)] = true
	var broken_cells := []
	for c in d.get("broken_walls", []):  # (An older save has none.)
		broken_cells.append(SaveData.data_to_cell(c))
	restore_broken_walls(broken_cells)
	var left := {}
	for entry in d.get("corruption", []):  # (An older save has none: every corrupted wall starts fresh.)
		left[SaveData.data_to_cell(entry.cell)] = int(entry.left)
	var purified_cells := []
	for c in d.get("purified_walls", []):
		purified_cells.append(SaveData.data_to_cell(c))
	DungeonMap.puzzles_done.clear()
	for id in d.get("puzzles_done", []):
		DungeonMap.puzzles_done[str(id)] = true
	DungeonMap.puzzle_doors.clear()
	for id in d.get("puzzle_doors", []):
		DungeonMap.puzzle_doors[str(id)] = true
	restore_corruption(left, purified_cells)
	restore_doors(open)
	var on := {}
	for l in d.levers:
		on[Vector3i(int(l[0]), int(l[1]), int(l[2]))] = true
	restore_levers(on)

	for id in d.get("runes_read", []):  # (An older save has read none.)
		_open_runes(str(id), false)
	DungeonMap.reliquaries.clear()  # (An older save has no seals, reliquaries or braziers.)
	for c in d.get("reliquaries", []):
		DungeonMap.reliquaries[SaveData.data_to_cell(c)] = true
	for e in d.get("braziers", []):
		var at := SaveData.data_to_cell(e.cell)
		if DungeonMap.brazier_lit.has(at):
			DungeonMap.brazier_lit[at] = e.lit
	DungeonMap.seals.clear()
	DungeonMap.sealed_doors.clear()
	for e in d.get("seals", []):
		if not DungeonMap.seals.has(e.area):
			DungeonMap.seals[e.area] = {}
		DungeonMap.seals[e.area][e.owner] = true
		for cell in DungeonMap.area_exits(e.area):
			DungeonMap.sealed_doors[cell] = true  # The doors are already as saved; one left open for whoever stands in it shuts on the next refresh.

	for cell in items.keys():
		set_pile(cell, [])
	for entry in d.items:
		var stacks := []
		for s in entry.pile:
			var stack := SaveData.data_to_stack(s)
			if stack != null:
				stacks.append(stack)
		set_pile(SaveData.data_to_cell(entry.cell), stacks)
	seal_show.sync(false)  # Seals, glowing mortar and open reliquaries as saved, with no show.

	DungeonMap.sconce_seen.clear()
	if d.has("sconces"):
		for e in d.sconces:
			var key := Vector3i(int(e.cell[0]), int(e.cell[1]), int(e.side))
			if sconces.has(key):
				DungeonMap.sconce_state[key] = int(e.state)
				DungeonMap.sconce_seconds[key] = maxf(0.0, float(e.seconds)) if int(e.state) != DungeonMap.SCONCE_EMPTY else 0.0
				if bool(e.get("seen", false)):
					DungeonMap.sconce_seen[key] = true
				_build_sconce(key)
	else:  # An older save: every wall torch was burning then.
		for key in sconces:
			DungeonMap.sconce_state[key] = DungeonMap.SCONCE_LIT
			DungeonMap.sconce_seconds[key] = LightConfig.get_config().sconce_torch_seconds
			_build_sconce(key)
	if oil != null:
		oil.load_state(d.get("oil", {"slicks": [], "burning": []}))  # (An older save has none.)
	if traps != null:
		traps.restore(d.get("armed_traps", []))  # (An older save has none.)
	if get("lights") != null:
		lights.restore()  # Lights lying lit in the piles burn again.

	clear_monsters()
	for mo in d.monsters:
		if ResourceLoader.exists(str(mo.def)):
			var monster: Node = spawn_monster(load(mo.def), SaveData.data_to_cell(mo.cell), int(mo.hp), float(mo.attack_cooldown))
			monster.load_state(mo)


## Put every door straight into the given open/closed state, with no animation (loading
## a save). `open` is a set of cells whose doors are open.
func restore_doors(open: Dictionary) -> void:
	DungeonMap.open_doors.clear()
	for cell in doors:
		if door_tweens.has(cell):
			door_tweens[cell].kill()
			door_tweens.erase(cell)
		var is_open := open.has(cell)
		door_want[cell] = is_open
		doors[cell].position.y = DungeonMap.WALL_HEIGHT / 2.0 + (DungeonMap.WALL_HEIGHT if is_open else 0.0)
		if is_open:
			DungeonMap.open_doors[cell] = true


## Set every lever on or off (loading a save). `on` is a set of Vector3i (x, z, side).
func restore_levers(on: Dictionary) -> void:
	lever_on.clear()
	for key in levers:
		lever_on[key] = on.has(key)
		levers[key].frame = 1 if on.has(key) else 0
		_sync_lever(key)


## Replace the whole pile on a cell (bottom first); an empty list clears the cell.
func set_pile(cell: Vector2i, stacks: Array) -> void:
	if items.has(cell):
		items[cell].sprite.queue_free()
		items.erase(cell)
	if stacks.is_empty():
		return
	place_item(cell, stacks[0])
	for i in range(1, stacks.size()):
		items[cell].pile.append(stacks[i])  # Straight on: no merging, the pile is as it was saved.
	_show_top(items[cell])


## Re-evaluate every switch: sink/raise plates and open/close linked doors.
## The player calls this (via the "dungeon" group) whenever it changes tile.
func refresh() -> void:
	_mark_sconces_seen()
	for cell in plates:
		var pressed: bool = DungeonMap.player_cell == cell
		plates[cell].position.y = PLATE_DOWN_Y if pressed else PLATE_UP_Y
		if plate_pressed.get(cell, false) != pressed:
			plate_pressed[cell] = pressed
			get_tree().call_group("audio", "play", "plate")
	for cell in doors:
		var id := DungeonMap.door_id(cell)
		if DungeonMap.is_sealed(cell):
			_drive_door(cell, false)  # (Waits while somebody stands in it.)
		elif id != "":
			_drive_door(cell, _linked_open(id))
	var changed := []
	for cell in plates:
		var held := plate_held(cell)
		if _plate_was_held.get(cell, false) != held:
			_plate_was_held[cell] = held
			changed.append([cell, held])
	if settled:
		for news in changed:  # (Sent after the doors have moved: a puzzle it wakes may move them again.)
			Events.send(get_tree(), "plate_changed", news)


## Toggle a lever and its sprite, then update the doors. Called by the player.
func pull_lever(cell: Vector2i, side: int) -> void:
	var key := Vector3i(cell.x, cell.y, side)
	if not levers.has(key):
		return
	lever_on[key] = not lever_on.get(key, false)
	levers[key].frame = 1 if lever_on[key] else 0
	_sync_lever(key)
	get_tree().call_group("audio", "play", "lever")
	Events.send(get_tree(), "lever_pulled", [cell, side, lever_on[key]])
	refresh()


## Should the door with this ID be open? Yes if any of its levers is on or the
## player is standing on any of its plates.
func _linked_open(id: String) -> bool:
	for plate in DungeonMap.PLATES:
		if plate.target == id and DungeonMap.player_cell == plate.cell:
			return true
	for lever in DungeonMap.LEVERS:
		if lever.target == id and lever_on.get(Vector3i(lever.cell.x, lever.cell.y, lever.side), false):
			return true
	return DungeonMap.puzzle_doors.has(id)  # A solved puzzle holds it open for good.


func _add_plate(cell: Vector2i) -> void:
	var mesh := BoxMesh.new()
	mesh.size = Vector3(PLATE_SIZE, 0.1, PLATE_SIZE)
	mesh.material = _make_material(Color(0.5, 0.5, 0.55), PLATE_TEXTURE)
	var plate := _add_mesh(mesh, DungeonMap.cell_to_world(cell))
	plate.position.y = PLATE_UP_Y
	plates[cell] = plate


## A wall lever: a 2-frame sprite (off / on) hung on one wall of a cell.
func _add_lever(cell: Vector2i, side: int) -> void:
	var sprite := Sprite3D.new()
	sprite.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	if ResourceLoader.exists(LEVER_SHEET):
		sprite.texture = load(LEVER_SHEET)
	sprite.hframes = 2
	sprite.pixel_size = LEVER_PIXEL_SIZE
	sprite.texture_filter = BaseMaterial3D.TEXTURE_FILTER_NEAREST
	sprite.shaded = false  # Tinted by the light that reaches it instead (sprite_lighting.gd).
	sprite.alpha_cut = SpriteBase3D.ALPHA_CUT_DISCARD
	sprite.position = _wall_point(cell, side, LEVER_HEIGHT)
	sprite.rotation.y = _face_yaw(side)
	add_child(sprite)
	levers[Vector3i(cell.x, cell.y, side)] = sprite
	# A faint warm light just off the wall (in "sprite_lights", so it also lights the lever): enough to find it, nothing more.
	var light := OmniLight3D.new()
	light.name = "Beacon"
	light.add_to_group("sprite_lights")
	light.omni_range = 2.0
	light.position = Vector3(0, 0, 0.4)
	sprite.add_child(light)
	_sync_lever(Vector3i(cell.x, cell.y, side))


## The lever's light for its state: a soft warm one until pulled, nearly none after.
func _sync_lever(key: Vector3i) -> void:
	var sprite: Sprite3D = levers.get(key)
	if sprite == null:
		return
	var light: OmniLight3D = sprite.get_node_or_null("Beacon")
	if light != null:
		light.light_color = LEVER_CALL
		light.light_energy = 0.05 if lever_on.get(key, false) else 0.2


## Point on the wall face at `side` of `cell`, at the given height (nudged off the wall).
func _wall_point(cell: Vector2i, side: int, height: float) -> Vector3:
	var d := SIDE_DIRS[side]
	var p := DungeonMap.cell_to_world(cell) + Vector3(d.x, 0, d.y) * (DungeonMap.TILE_SIZE / 2.0 - 0.02)
	p.y = height
	return p


## Yaw that turns a sprite (front = +Z) to face into the room, away from that wall.
func _face_yaw(side: int) -> float:
	return atan2(float(SIDE_DIRS[side].x) * -1.0, float(SIDE_DIRS[side].y) * -1.0)


## The top item stack lying on this floor cell, or null if there isn't one. A tile
## holds a pile (several stacks); only the top one can be picked up. Called directly
## by the player (get_tree().get_first_node_in_group("dungeon")), not via call_group,
## since it needs to return a value.
func item_at(cell: Vector2i) -> RefCounted:
	return items[cell].pile.back() if items.has(cell) else null


## Every stack in the pile on this cell, bottom first (empty if none).
func pile_at(cell: Vector2i) -> Array:
	return items[cell].pile.duplicate() if items.has(cell) else []


## Remove and return the top item stack on this cell (null if there wasn't one).
func take_item(cell: Vector2i) -> RefCounted:
	if not items.has(cell):
		return null
	var entry: Dictionary = items[cell]
	var stack: RefCounted = entry.pile.pop_back()
	if entry.pile.is_empty():
		entry.sprite.queue_free()
		items.erase(cell)
	else:
		_show_top(entry)
	_pile_news(cell)
	return stack


## Put an item on a floor cell, on top of whatever is there (merging into the top
## stack if it's the same stackable item). The pile is one small sprite that bobs
## gently near the ground, showing the top item. Used for the level's starting items,
## items dropped from the cursor, and thrown weapons landing.
func place_item(cell: Vector2i, item) -> void:
	var stack: RefCounted = ItemStack.wrap(item)  # An ItemDef (one) or a whole stack.
	if items.has(cell):
		var entry: Dictionary = items[cell]
		entry.pile.back().merge_from(stack)
		if stack.count > 0:
			entry.pile.append(stack)
		_show_top(entry)
		_pile_news(cell)
		return
	var sprite := Sprite3D.new()
	sprite.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	sprite.texture_filter = BaseMaterial3D.TEXTURE_FILTER_NEAREST
	sprite.billboard = BaseMaterial3D.BILLBOARD_ENABLED
	sprite.shaded = false  # Tinted by the light that reaches it instead (sprite_lighting.gd).
	sprite.alpha_cut = SpriteBase3D.ALPHA_CUT_DISCARD
	var height := RELIQUARY_ITEM_HEIGHT if DungeonMap.reliquaries.has(cell) else ITEM_HEIGHT
	sprite.position = DungeonMap.cell_to_world(cell) + Vector3(0, height, 0)
	add_child(sprite)
	var new_entry := {"sprite": sprite, "pile": [stack]}
	items[cell] = new_entry
	_show_top(new_entry)
	# Bob up and down forever (the tween is owned by the sprite, so it dies with it).
	var bob := sprite.create_tween().set_loops()
	bob.tween_property(sprite, "position:y", height + ITEM_BOB, 0.9).set_trans(Tween.TRANS_SINE)
	bob.tween_property(sprite, "position:y", height - ITEM_BOB, 0.9).set_trans(Tween.TRANS_SINE)
	_pile_news(cell)


func _pile_news(cell: Vector2i) -> void:
	if settled:
		Events.send(get_tree(), "pile_changed", [cell])


func _show_top(entry: Dictionary) -> void:
	var def: Resource = entry.pile.back().def
	entry.sprite.texture = def.floor_texture(entry.pile.back().count)  # The small floor version.
	entry.sprite.pixel_size = def.icon_pixel_size
	_sync_glow(entry.sprite, def)


## A glowing item (ItemDef.glow_light_energy: a legendary's pale light) carries a soft real light while it lies on the floor, in the group
## "sprite_lights" like the spells' lights; an item that does not glow carries none (the top of a pile may change).
func _sync_glow(sprite: Node3D, def: Resource) -> void:
	var light: OmniLight3D = sprite.get_node_or_null("GlowLight")
	if def.glow_light_energy <= 0.0:
		if light != null:
			sprite.remove_child(light)
			light.queue_free()
		return
	if light == null:
		light = OmniLight3D.new()
		light.name = "GlowLight"
		light.add_to_group("sprite_lights")
		sprite.add_child(light)
	light.light_color = def.glow_light_color
	light.light_energy = def.glow_light_energy
	light.omni_range = def.glow_light_range


## Show a thrown item flying from the party's tile to where it lands (for show only:
## Party has already resolved the hit and placed the item). Also called via the group.
func show_throw(from_cell: Vector2i, to_cell: Vector2i, def: Resource) -> void:
	var sprite := Sprite3D.new()
	sprite.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	sprite.texture = def.floor_texture(1)  # What flies is always a single one.
	sprite.pixel_size = def.icon_pixel_size
	sprite.texture_filter = BaseMaterial3D.TEXTURE_FILTER_NEAREST
	sprite.billboard = BaseMaterial3D.BILLBOARD_ENABLED
	sprite.shaded = false  # Tinted by the light that reaches it instead (sprite_lighting.gd).
	sprite.alpha_cut = SpriteBase3D.ALPHA_CUT_DISCARD
	sprite.position = DungeonMap.cell_to_world(from_cell) + Vector3(0, THROW_HEIGHT, 0)
	add_child(sprite)
	if def.is_light():  # A thrown torch flies with its light.
		var light := OmniLight3D.new()
		light.light_color = def.light_color
		light.light_energy = def.light_energy * 0.6
		light.omni_range = def.light_range * 0.6
		sprite.add_child(light)
	var tiles := maxf(1.0, (to_cell - from_cell).length())
	var t := sprite.create_tween()
	t.tween_property(sprite, "position", DungeonMap.cell_to_world(to_cell) + Vector3(0, ITEM_HEIGHT, 0), THROW_TIME_PER_TILE * tiles)
	t.tween_callback(sprite.queue_free)


## Break a cracked wall. The state changes at once (the tile is floor from this moment, in the
## level state that is saved); `delay` holds back only the show, so a fireball can arrive first.
## `burst` false is for loading a save: no cubes, dust, sound or shake, just the result.
## Returns false for anything that is not a standing cracked wall (ordinary walls, doors and
## portcullises never break).
func break_wall(cell: Vector2i, burst := true, delay := 0.0) -> bool:
	if not DungeonMap.is_destructible(cell):
		return false
	DungeonMap.broken_walls[cell] = true
	Events.send(get_tree(), "wall_broken", [cell])
	if burst and delay > 0.0:
		get_tree().create_timer(delay).timeout.connect(func(): _show_break(cell, true))
	else:
		_show_break(cell, burst)
	return true


## Put every wall in this list of cells in the broken state, with no show (loading a save).
func restore_broken_walls(cells: Array) -> void:
	for cell in cells:
		if DungeonMap.is_destructible(cell):  # (Not break_wall: loading a save is not news for GameEvents.)
			DungeonMap.broken_walls[cell] = true
			_show_break(cell, false)


func _show_break(cell: Vector2i, burst: bool) -> void:
	if not is_inside_tree():
		return
	var h := DungeonMap.WALL_HEIGHT
	var pos := DungeonMap.cell_to_world(cell)
	if walls.has(cell):
		walls[cell].queue_free()
		walls.erase(cell)
	if not rubble.has(cell):
		_open_cell(cell)  # A wall cell had no floor or ceiling of its own, and the walls beside it no face towards it.
		rubble[cell] = _add_rubble(cell)
	if not burst:
		return
	var toward := Vector3.ZERO
	var player := get_tree().get_first_node_in_group("player")
	if player != null:
		toward = Vector3(player.position.x - pos.x, 0, player.position.z - pos.z).normalized()
	var debris := Node3D.new()
	debris.set_script(WallDebris)
	add_child(debris)
	debris.start(cell, toward, _wall_material)
	get_tree().call_group("audio", "play", "rumble")
	get_tree().call_group("combat_feel", "shake_by", 0.07, 0.4)


# --------------------------------------------------------------------------
# Corrupted walls (tile 7): see corrupt_wall.gd for the show
# --------------------------------------------------------------------------

func _add_corrupt_wall(cell: Vector2i) -> Node3D:
	var s := DungeonMap.TILE_SIZE
	var h := DungeonMap.WALL_HEIGHT
	var box := _wall_box(Vector3(s, h, s), _make_material(WALL_COLOR, WALL_CORRUPTED_TEXTURE))
	var wall: Node3D = CorruptWall.new()
	add_child(wall)
	wall.setup(cell, box, int(DungeonMap.CORRUPTION.get(cell, 1)))
	return wall


## A floor and ceiling for a cell that was a wall, and a face on each wall beside it that never had one (the plain walls only
## build the faces that can be seen, and this cell used to be solid).
func _open_cell(cell: Vector2i) -> void:
	var h := DungeonMap.WALL_HEIGHT
	var pos := DungeonMap.cell_to_world(cell)
	_add_mesh(_floor_mesh, pos)
	_add_mesh(_ceiling_mesh, pos + Vector3(0, h, 0), Vector3(PI, 0, 0))
	if _decor == null or not _decor.active():
		return  # The old blocks are whole boxes: nothing is missing.
	for side in 4:
		var near: Vector2i = cell + SIDE_DIRS[side]
		if DungeonMap.is_wall(near) and not DungeonMap.is_corrupted(near) and not DungeonMap.is_destructible(near):
			var before := get_child_count()
			_decor.add_face(self, near, (side + 2) % 4)
			if _rune_faces.has(near):
				_rune_faces[near].append_array(get_children().slice(before))


## A Bless is sent into the wall in `cell`. Returns {"ok": false} if it is not a corrupted wall that can be blessed, else
## {"ok": true, "purified": bool, "left": Blesses still needed}. The state changes at once; the show runs on its own.
func bless_wall(cell: Vector2i) -> Dictionary:
	if not DungeonMap.is_corrupted(cell) or DungeonMap.purify_pending.has(cell) or not corrupt.has(cell):
		return {"ok": false}
	var left: int = int(DungeonMap.corrupted_left.get(cell, 1)) - 1
	if left > 0:
		DungeonMap.corrupted_left[cell] = left
		corrupt[cell].bless_partial()
		return {"ok": true, "purified": false, "left": left}
	_purify(cell, true)
	return {"ok": true, "purified": true, "left": 0}


## Burn a corrupted wall away without a Bless (a puzzle effect), with the show.
func purify_wall(cell: Vector2i) -> bool:
	if not DungeonMap.is_corrupted(cell) or DungeonMap.purify_pending.has(cell) or not corrupt.has(cell):
		return false
	_purify(cell, true)
	return true


func _purify(cell: Vector2i, show: bool) -> void:
	DungeonMap.corrupted_left[cell] = 0
	DungeonMap.purify_pending[cell] = true  # Still solid until the ash has hidden it.
	var node: Node3D = corrupt.get(cell)
	var finish := func():
		DungeonMap.purify_pending.erase(cell)
		DungeonMap.purified[cell] = true
		DungeonMap.corrupted_left.erase(cell)
		corrupt.erase(cell)
		refresh()
		if show:  # (Not when a save puts a purified wall back.)
			Events.send(get_tree(), "wall_purified", [cell])  # (Puzzles hear it: puzzles.gd listens to the bus.)
	if show and node != null:
		node.purify(func(): _open_cell(cell), finish)
	else:
		if node != null:
			node.queue_free()
		_open_cell(cell)
		finish.call()


## Put the corruption back as a save left it, with no show: `left` is cell -> Blesses still needed (every other corrupted wall
## is gone) and `purified_cells` the walls burned away.
func restore_corruption(left: Dictionary, purified_cells: Array) -> void:
	for cell in purified_cells:
		if DungeonMap.MAP[cell.y][cell.x] == 7 and corrupt.has(cell):
			_purify(cell, false)
	for cell in left:
		if corrupt.has(cell) and DungeonMap.is_corrupted(cell):
			DungeonMap.corrupted_left[cell] = int(left[cell])
			corrupt[cell].set_burn(corrupt[cell]._partial_burn())


## The permanent rubble: a handful of small static stone blocks lying on the floor, the wall's own
## colours. The same every time for a given cell (so a loaded game looks as it did).
func _add_rubble(cell: Vector2i) -> Node3D:
	var root := Node3D.new()
	root.position = DungeonMap.cell_to_world(cell)
	add_child(root)
	var rng := RandomNumberGenerator.new()
	rng.seed = hash(cell) + 3
	for i in 8:
		var size := rng.randf_range(0.1, 0.3)
		var block := MeshInstance3D.new()
		var box := BoxMesh.new()
		box.size = Vector3(size, size * rng.randf_range(0.5, 1.0), size * rng.randf_range(0.7, 1.2))
		box.material = _wall_material
		block.mesh = box
		block.position = Vector3(rng.randf_range(-0.8, 0.8), box.size.y / 2.0 - 0.02, rng.randf_range(-0.8, 0.8))
		block.rotation = Vector3(rng.randf_range(-0.2, 0.2), rng.randf() * TAU, rng.randf_range(-0.2, 0.2))
		root.add_child(block)
	return root


## Open an ordinary door (F). Called by the player via the "dungeon" group.
func open_door(cell: Vector2i) -> void:
	if not DungeonMap.is_locked(cell) and not DungeonMap.is_portcullis(cell) and not DungeonMap.is_sealed(cell):  # (A portcullis only opens through its switches.)
		_drive_door(cell, true)


## Slide a door up into the ceiling (open) or back down (closed). Doors can be
## reversed mid-slide. Open doors are walkable only once fully open; closing makes
## them solid immediately. A door never closes on the player standing in it: it
## (or a monster) stays open until they leave and the next refresh() shuts it.
func _drive_door(cell: Vector2i, open: bool) -> void:
	if not doors.has(cell) or door_want.get(cell, false) == open or (open and DungeonMap.is_sealed(cell)):
		return
	if not open and (DungeonMap.player_cell == cell or DungeonMap.is_occupied(cell)):
		return
	door_want[cell] = open
	var grate := DungeonMap.is_portcullis(cell)
	get_tree().call_group("audio", "play", "portcullis" if grate else ("door_open" if open else "door_close"))
	if door_tweens.has(cell):
		door_tweens[cell].kill()

	var h := DungeonMap.WALL_HEIGHT
	var door: MeshInstance3D = doors[cell]
	var target_y := h / 2.0 + (h if open else 0.0)
	var time := (PORTCULLIS_TIME if grate else DOOR_OPEN_TIME) * absf(target_y - door.position.y) / h
	var tween := create_tween()
	tween.tween_property(door, "position:y", target_y, time)
	if open:
		# Only become walkable once the panel is out of the way.
		tween.tween_callback(func(): DungeonMap.open_doors[cell] = true)
	else:
		DungeonMap.open_doors.erase(cell)
	door_tweens[cell] = tween


func _add_door(mesh: Mesh, cell: Vector2i, pos: Vector3) -> void:
	# The panel fills the gap between two side walls: if walls sit east and west of
	# the cell the corridor runs north-south and the panel spans X; otherwise turn it.
	var spans_x := DungeonMap.is_wall(cell + Vector2i(1, 0)) and DungeonMap.is_wall(cell + Vector2i(-1, 0))
	doors[cell] = _add_mesh(mesh, pos, Vector3(0, 0.0 if spans_x else PI / 2.0, 0))


## (Re)build one wall sconce for what it holds now (DungeonMap.sconce_state): a lit one is the animated torch with its flickering
## light, an unlit one a bracket with a dead torch, an empty one a bare bracket (both PixelLab stills, shaded by the light that
## reaches them). Throws away what was there, so it is also how a change of state shows.
func _build_sconce(key: Vector3i) -> void:
	var old: Dictionary = sconces.get(key, {})
	if old.has("sprite"):
		old.sprite.queue_free()
		if old.light != null:
			old.light.queue_free()
	var cell := Vector2i(key.x, key.y)
	var side := key.z
	var state: int = DungeonMap.sconce_state.get(key, DungeonMap.SCONCE_LIT)
	var dir := Vector3(SIDE_DIRS[side].x, 0, SIDE_DIRS[side].y)
	var wall_pos := _wall_point(cell, side, TORCH_HEIGHT)
	var sprite: SpriteBase3D
	var light: OmniLight3D = null
	if state == DungeonMap.SCONCE_LIT or not ResourceLoader.exists(SCONCE_SHEETS[state]):
		var flame := AnimatedSprite3D.new()
		flame.sprite_frames = _make_torch_frames()
		flame.pixel_size = TORCH_PIXEL_SIZE
		flame.shaded = false                               # Glows regardless of lights.
		flame.modulate = SpellEffectsConfigScript.get_config().glow_torch_tint  # HDR: the flame blooms a little (see "Glow (bloom)").
		sprite = flame
	else:
		var still := Sprite3D.new()
		still.texture = load(SCONCE_SHEETS[state])
		still.pixel_size = SCONCE_PIXEL_SIZE
		still.shaded = true                                # Dark metal: only the light that reaches it shows it.
		still.modulate = Color(1.7, 1.7, 1.7)                # A little brighter than the picture: dark iron must still read (the art style's readability rule).
		sprite = still
	sprite.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	sprite.texture_filter = BaseMaterial3D.TEXTURE_FILTER_NEAREST
	sprite.alpha_cut = SpriteBase3D.ALPHA_CUT_DISCARD   # Hard pixel edges, no sorting issues.
	sprite.position = wall_pos
	sprite.rotation.y = _face_yaw(side)                 # Face into the room.
	add_child(sprite)
	if sprite is AnimatedSprite3D:
		sprite.play("default")
	if state == DungeonMap.SCONCE_LIT:
		light = OmniLight3D.new()
		light.set_script(TorchLight)
		light.shadow_kind = "torches"
		light.base_energy = TORCH_ENERGY
		light.light_color = Color(1.0, 0.77, 0.56)
		light.omni_range = 5.0
		light.omni_attenuation = 1.5
		light.position = wall_pos - dir * 0.4 + Vector3(0, 0.3, 0)
		add_child(light)
	sconces[key] = {"sprite": sprite, "light": light}


## Cut the torch sprite sheet (one row of frames, each half as wide as it is tall) into an
## animation. The number of frames is read from the sheet itself, so art with more frames
## just works. Returns an empty set if the sheet is missing.
func _make_torch_frames() -> SpriteFrames:
	return torch_frames_from(load(TORCH_SHEET) if ResourceLoader.exists(TORCH_SHEET) else null)


## The torch animation from a sheet texture (null gives an empty one).
func torch_frames_from(sheet: Texture2D) -> SpriteFrames:
	var frames := SpriteFrames.new()  # Comes with an animation called "default".
	frames.set_animation_speed("default", 8.0)
	if sheet != null:
		var frame_h := sheet.get_height()
		var frame_w := maxi(1, int(frame_h * 0.5))  # Torch frames are 1:2 (16x32 as drawn).
		for i in maxi(1, int(sheet.get_width() / float(frame_w))):
			var frame := AtlasTexture.new()
			frame.atlas = sheet
			frame.region = Rect2(i * frame_w, 0, frame_w, frame_h)
			frames.add_frame("default", frame)
	return frames


func _add_mesh(mesh: Mesh, pos: Vector3, rot := Vector3.ZERO) -> MeshInstance3D:
	var instance := MeshInstance3D.new()
	instance.mesh = mesh
	instance.position = pos
	instance.rotation = rot
	add_child(instance)
	return instance


## Material with nearest filtering. Uses the texture if it exists, else a flat colour.
## Transparent iron bars: alpha cut-out (hard pixel edges, no sorting problems), visible from both sides.
func _make_grate_material(texture_path: String) -> StandardMaterial3D:
	var mat := _make_material(Color(0.4, 0.4, 0.45), texture_path)
	mat.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA_SCISSOR
	mat.alpha_scissor_threshold = 0.5
	mat.cull_mode = BaseMaterial3D.CULL_DISABLED
	return mat


## The cracked wall: the usual textured material, plus an emission map that holds only the crack's
## green glow pixels, so the curse seeps out of the wall by its own light (and can be dimmed).
func _make_cracked_material() -> StandardMaterial3D:
	var mat := _make_material(WALL_COLOR, WALL_CRACKED_TEXTURE)
	var tex: Texture2D = mat.albedo_texture
	if tex != null:
		var image: Image = tex.get_image()
		if image != null:
			image.decompress()
			image.convert(Image.FORMAT_RGBA8)
			for y in image.get_height():
				for x in image.get_width():
					var c := image.get_pixel(x, y)
					# Only the crack's pale green core (curse_300 and brighter), not the lit green stone around it.
					var glowing := c.g > 0.85 and c.g > c.r + 0.05
					image.set_pixel(x, y, c if glowing else Color(0, 0, 0, 1))
			mat.emission_enabled = true
			mat.emission_texture = ImageTexture.create_from_image(image)
			mat.emission = Color.BLACK  # In Godot 4 the emission texture is ADDED to this colour, so black leaves just the glow map.
			mat.emission_energy_multiplier = CURSE_GLOW
	return mat


## Dim every curse glow for a moment (holy light): down by `amount` (0 none .. 1 out) over `seconds_in`,
## held for `hold`, then back over `seconds_out`. Called through the group "dungeon".
func dim_curse(amount: float, seconds_in: float, hold: float, seconds_out: float) -> void:
	if _curse_material == null:
		return
	if _curse_tween and _curse_tween.is_valid():
		_curse_tween.kill()
	var low := CURSE_GLOW * (1.0 - clampf(amount, 0.0, 1.0))
	_curse_tween = create_tween()
	_curse_tween.tween_property(_curse_material, "emission_energy_multiplier", low, maxf(0.01, seconds_in))
	_curse_tween.tween_interval(hold)
	_curse_tween.tween_property(_curse_material, "emission_energy_multiplier", CURSE_GLOW, maxf(0.01, seconds_out))


## Which plain wall picture a cell gets (a fixed scatter, the same every run).
func _wall_variant(cell: Vector2i) -> int:
	return int(absi(cell.x * 73856093 ^ cell.y * 19349663) % WALL_VARIANTS.size())


## A wall block whose four side faces each show the WHOLE texture (a BoxMesh would give each face
## one cell of a 3x2 grid). No top or bottom: nothing can see them.
func _wall_box(size: Vector3, material: Material) -> ArrayMesh:
	var hx := size.x / 2.0
	var hy := size.y / 2.0
	var hz := size.z / 2.0
	# Each face: four corners (bottom-left, bottom-right, top-right, top-left seen from outside) and its normal.
	# The last two entries: the face's normal and its tangent (the way U runs along it), for normal maps.
	var faces := [
		[Vector3(-hx, -hy, hz), Vector3(hx, -hy, hz), Vector3(hx, hy, hz), Vector3(-hx, hy, hz), Vector3(0, 0, 1), Vector3(1, 0, 0)],
		[Vector3(hx, -hy, hz), Vector3(hx, -hy, -hz), Vector3(hx, hy, -hz), Vector3(hx, hy, hz), Vector3(1, 0, 0), Vector3(0, 0, -1)],
		[Vector3(hx, -hy, -hz), Vector3(-hx, -hy, -hz), Vector3(-hx, hy, -hz), Vector3(hx, hy, -hz), Vector3(0, 0, -1), Vector3(-1, 0, 0)],
		[Vector3(-hx, -hy, -hz), Vector3(-hx, -hy, hz), Vector3(-hx, hy, hz), Vector3(-hx, hy, -hz), Vector3(-1, 0, 0), Vector3(0, 0, 1)],
	]
	var verts := PackedVector3Array()
	var norms := PackedVector3Array()
	var tangents := PackedFloat32Array()
	var uvs := PackedVector2Array()
	var idx := PackedInt32Array()
	for f in faces:
		var base := verts.size()
		for k in 4:
			verts.append(f[k])
			norms.append(f[4])
			tangents.append_array([f[5].x, f[5].y, f[5].z, 1.0])
		uvs.append_array([Vector2(0, 1), Vector2(1, 1), Vector2(1, 0), Vector2(0, 0)])
		idx.append_array([base, base + 2, base + 1, base, base + 3, base + 2])
	var arrays := []
	arrays.resize(Mesh.ARRAY_MAX)
	arrays[Mesh.ARRAY_VERTEX] = verts
	arrays[Mesh.ARRAY_NORMAL] = norms
	arrays[Mesh.ARRAY_TANGENT] = tangents
	arrays[Mesh.ARRAY_TEX_UV] = uvs
	arrays[Mesh.ARRAY_INDEX] = idx
	var mesh := ArrayMesh.new()
	mesh.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arrays)
	mesh.surface_set_material(0, material)
	return mesh


func _make_material(color: Color, texture_path: String) -> StandardMaterial3D:
	var mat := StandardMaterial3D.new()
	if ResourceLoader.exists(texture_path):
		mat.albedo_texture = load(texture_path)
	else:
		mat.albedo_color = color
	mat.texture_filter = BaseMaterial3D.TEXTURE_FILTER_NEAREST
	NormalMaps.apply(mat, texture_path)
	return mat
