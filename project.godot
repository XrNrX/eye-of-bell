; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Eye of Bell"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[display]

; Internal render size: the 3D scene is drawn at 320x200...
window/size/viewport_width=320
window/size/viewport_height=200
; ...but the OS window opens at 3x that size.
window/size/window_width_override=960
window/size/window_height_override=600
; "viewport" stretch renders at the small size, then scales the final image up.
window/stretch/mode="viewport"
window/stretch/aspect="keep"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
